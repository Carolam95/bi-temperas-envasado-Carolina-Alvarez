      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": "PostgreSQL-BITemperas",
          "format": "table",
          "rawSql": "SELECT fp.paro_id, df.fecha, dm.codigo_maquina, dt.nombre_turno, dcp.codigo_paro_texto, COALESCE(dcp.descripcion_subcodigo, 'General') AS detalle_falla, ROUND(fp.duracion_minutos, 1) AS duracion_min, dsp.nivel_severidad, dai.nombre_personal AS tecnico_atencion, fp.fecha_registro FROM bi_temperas.fact_paros fp JOIN bi_temperas.dim_fecha df ON fp.fecha_key = df.fecha_key JOIN bi_temperas.dim_maquina dm ON fp.maquina_key = dm.maquina_key JOIN bi_temperas.dim_turno dt ON fp.turno_key = dt.turno_key JOIN bi_temperas.dim_codigo_paro dcp ON fp.codigo_paro_key = dcp.codigo_paro_key LEFT JOIN bi_temperas.dim_severidad_paro dsp ON fp.severidad_key = dsp.severidad_key LEFT JOIN bi_temperas.dim_agente_intervencion dai ON fp.agente_key = dai.agente_key WHERE ('$maquina' = 'Todos' OR dm.codigo_maquina = '$maquina') ORDER BY fp.paro_id DESC LIMIT 50;",
          "refId": "A"
        }
      ],
      "title": "Auditoría de Paros en Tiempo Real (Últimos 50 Eventos)",
