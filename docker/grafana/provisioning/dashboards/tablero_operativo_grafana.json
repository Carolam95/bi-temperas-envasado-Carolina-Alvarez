          "rawSql": "SELECT df.fecha AS time, SUM(fp.duracion_minutos) AS value, dcp.area_impacto AS metric FROM bi_temperas.fact_paros fp JOIN bi_temperas.dim_fecha df ON fp.fecha_key = df.fecha_key JOIN bi_temperas.dim_codigo_paro dcp ON fp.codigo_paro_key = dcp.codigo_paro_key JOIN bi_temperas.dim_maquina dm ON fp.maquina_key = dm.maquina_key WHERE ('$maquina' = 'Todos' OR dm.codigo_maquina = '$maquina') GROUP BY df.fecha, dcp.area_impacto ORDER BY df.fecha;",
